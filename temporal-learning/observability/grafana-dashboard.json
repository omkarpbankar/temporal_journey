{
  "title": "Temporal Workers",
  "uid": "temporal-workers",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "SDK metrics have no direct Activity timeout counter. Read timeouts from Workflow history or server metrics.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Workflow success rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(temporal_workflow_completed[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Workflow failure rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(temporal_workflow_failed[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Activity failure rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (activity_type) (rate(temporal_activity_execution_failed[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Activity retry signal (failed attempts per second)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (activity_type) (rate(temporal_activity_execution_failed[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Activity latency p95 (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, activity_type) (rate(temporal_activity_execution_latency_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Workflow duration p95 (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, workflow_type) (rate(temporal_workflow_endtoend_latency_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Task Queue backlog: Activity Schedule-To-Start p95 (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, task_queue) (rate(temporal_activity_schedule_to_start_latency_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Worker availability: pollers",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (task_queue) (temporal_num_pollers)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Free task slots",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "min by (task_queue, worker_type) (temporal_worker_task_slots_available)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Cancellations per second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(temporal_workflow_canceled[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}